# Domain / public URLs (local defaults)
# Angular sync (`npm run firebase:sync-web`) writes PUBLIC_API_URL + PUBLIC_STANDUP_URL
# into gitignored public-urls.local.ts. On Cloudflare Pages set production values:
#   PUBLIC_API_URL=https://api.silvervibe.io/api
#   PUBLIC_STANDUP_URL=https://standup.silvervibe.io
PUBLIC_APP_URL=http://localhost:4200
PUBLIC_STANDUP_URL=http://localhost:4201
PUBLIC_API_URL=http://localhost:3000/api
PUBLIC_AI_URL=http://localhost:8000

# Runtime
NODE_ENV=development

# Neon Postgres (placeholders OK until Neon is provisioned — issues #3 / #4)
# prisma generate works without a live DB; migrate needs real URLs
# DATABASE_URL = pooled; DATABASE_URL_UNPOOLED = direct (Prisma directUrl)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Firebase Auth — see docs/firebase.md (issue #5)
# Web (client): keep only here locally. `npm run firebase:sync-web` / serve writes
# gitignored firebase-web.local.ts. In CI/Pages, set the same vars as build secrets.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Admin (Nest — secret). Leave empty → Bearer dev:<uid> outside production
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY: paste JSON private_key with \n escapes in .env


# GrowthBook / OpenFeature — see docs/growthbook.md (issue #8)
# Leave empty → static in-memory defaults. CLIENT_KEY syncs to Angular local env.
GROWTHBOOK_API_HOST=https://cdn.growthbook.io
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_SERVER_KEY=

# Founder UI preview switcher (role + plan tier). Comma-separated Firebase emails.
# Empty → switcher hidden. Does not bypass Nest RBAC. See docs/growthbook.md.
PREVIEW_SWITCHER_EMAILS=

# Nest API (local). Do not set PORT here — Vite/Angular read PORT and bind to it
# instead of 4200. Cloud Run injects PORT at runtime; Nest accepts either.
API_PORT=3000
# Local defaults. Cloud Run production example:
# CORS_ORIGINS=https://silvervibe.io,https://www.silvervibe.io,https://standup.silvervibe.io
CORS_ORIGINS=http://localhost:4200,http://localhost:4201
# Optional bind host (default 0.0.0.0):
# HOST=0.0.0.0

# Transactional email (team invites) — https://resend.com
# Leave RESEND_API_KEY empty → invites still work; copy the accept link in UI.
# With the free onboarding sender you can only deliver to your Resend account email.
# For production: verify silvervibe.io in Resend and set EMAIL_FROM accordingly.
RESEND_API_KEY=
# Quote the value so angle brackets survive dotenv parsing.
EMAIL_FROM="VibeStandup <onboarding@resend.dev>"
# After verifying silvervibe.io in Resend:
# EMAIL_FROM="VibeStandup <invites@silvervibe.io>"

# Cron / Cloud Scheduler for POST /api/jobs/standup-reminders
# Header: X-Cron-Secret: <same value>  (or Authorization: Bearer <same>)
CRON_SECRET=

# Slack OAuth (standup digest) — see docs/slack-digest.md (#103)
# Redirect URL in Slack app settings must match:
#   ${PUBLIC_API_URL}/addons/slack/oauth/callback
# e.g. http://localhost:3000/api/addons/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional; for future request signing
# SLACK_SIGNING_SECRET=
# Optional override if redirect differs from PUBLIC_API_URL + path
# SLACK_REDIRECT_URI=

# AI service (apps/ai — Python / uv)
AI_PORT=8000
