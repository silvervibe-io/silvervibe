# Domain
PUBLIC_APP_URL=http://localhost:4200
PUBLIC_STANDUP_URL=http://localhost:4201
PUBLIC_API_URL=http://localhost:3000/api
PUBLIC_AI_URL=http://localhost:8000

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Firebase Auth (web — safe to expose in Angular env files)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firebase Admin (Nest on Cloud Run — keep secret)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY should keep escaped newlines as \n in .env

# GrowthBook / OpenFeature
GROWTHBOOK_API_HOST=https://cdn.growthbook.io
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_SERVER_KEY=

# Nest
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# AI service
AI_PORT=8000
