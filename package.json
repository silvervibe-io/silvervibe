    "start:vibestandup": "nx serve vibestandup",
    "start:api": "nx serve api",
    "start:ai": "nx serve ai",
    "build": "nx run-many -t build -p silvervibe,vibestandup,api",
    "build:silvervibe": "nx build silvervibe",
    "build:vibestandup": "nx build vibestandup",
    "build:api": "nx build api",
    "test": "nx run-many -t test -p silvervibe,vibestandup,ui,data-access,feature-flags,auth,api,ai",
