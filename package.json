    "lint:vibestandup": "nx lint vibestandup",
    "lint:ui": "nx lint ui",
    "lint:api": "nx lint api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "nx openapi api",
    "graph": "nx graph",
    "prisma:generate": "prisma generate --schema=libs/shared/data-access/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=libs/shared/data-access/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=libs/shared/data-access/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=libs/shared/data-access/prisma/schema.prisma",
    "prisma:ping": "node ./tools/prisma-ping.mjs",
    "firebase:check": "node ./tools/firebase-check.mjs",
    "postinstall": "prisma generate --schema=libs/shared/data-access/prisma/schema.prisma && node ./tools/ensure-firebase-web-local.mjs",
    "licenses:report": "npx license-checker --production --summary",
    "licenses:dump": "npx license-checker --production --customPath licenses/customFormat.json --out licenses/THIRD_PARTY_LICENSES.txt"
  },
