  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Firebase ID token. Outside production, when Admin is unset: Bearer dev:<uid>."
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Neon user id (cuid)"
          },
          "firebaseUid": {
            "type": "string",
            "description": "Firebase Auth uid"
          },
          "email": {
            "type": "object",
            "nullable": true
          },
          "displayName": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "firebaseUid"
        ]
      },
      "CreateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme"
          },
          "slug": {
            "type": "string",
            "example": "acme"
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "WorkspaceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "WorkspaceToolDto": {
        "type": "object",
        "properties": {
          "toolKey": {
            "type": "string",
            "example": "vibestandup"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "toolKey",
          "enabled"
        ]
      },
      "SetToolEntitlementDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "true = grant / keep entitlement; false = revoke"
          }
        },
        "required": [
          "enabled"
        ]
      },
      "FlagEvaluationDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "enabled"
        ]
      },
      "AddonStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "slack"
          },
          "status": {
            "type": "string",
            "example": "ready"
          }
        },
        "required": [
          "name",
          "status"
        ]
      }
    }
  }
}