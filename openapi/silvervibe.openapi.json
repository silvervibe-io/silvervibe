        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firebaseUid": {
            "type": "string"
          },
          "email": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "firebaseUid"
        ]
      },
      "FlagEvaluationDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "enabled"
        ]
      },
      "AddonStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "slack"
          },
          "status": {
            "type": "string",
            "example": "ready"
          }
        },
        "required": [
          "name",
          "status"
        ]
      }
