{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "summary": "API health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/me": {
      "get": {
        "description": "Requires `Authorization: Bearer <Firebase ID token>`. Upserts the Neon `users` row by `firebase_uid`. Outside production, when Firebase Admin is not configured, `Bearer dev:<uid>` is accepted.",
        "operationId": "UsersController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired Bearer token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Current authenticated user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/workspaces": {
      "post": {
        "description": "Foundation helper to create a workspace so tool entitlements can be granted.",
        "operationId": "WorkspacesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a workspace",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/workspaces/{workspaceId}/tools": {
      "get": {
        "description": "Ownership rows from `workspace_tools` (not GrowthBook rollout flags).",
        "operationId": "WorkspacesController_listTools",
        "parameters": [
          {
            "name": "workspaceId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkspaceToolDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List workspace tool entitlements",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/workspaces/{workspaceId}/tools/{toolKey}": {
      "put": {
        "description": "`enabled: true` grants (upserts); `enabled: false` revokes. `toolKey` must be a known TOOL_KEYS value.",
        "operationId": "WorkspacesController_setTool",
        "parameters": [
          {
            "name": "workspaceId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "toolKey",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetToolEntitlementDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceToolDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Grant or revoke a tool entitlement",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/flags/vibestandup": {
      "get": {
        "operationId": "FeatureFlagsController_vibestandup",
        "parameters": [
          {
            "name": "workspaceId",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-firebase-uid",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlagEvaluationDto"
                }
              }
            }
          }
        },
        "summary": "Evaluate vibestandup rollout flag",
        "tags": [
          "flags"
        ]
      }
    },
    "/api/addons/slack/status": {
      "get": {
        "operationId": "SlackController_status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddonStatusDto"
                }
              }
            }
          }
        },
        "summary": "Slack add-on status",
        "tags": [
          "slack"
        ]
      }
    },
    "/api/addons/teams/status": {
      "get": {
        "operationId": "TeamsController_status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddonStatusDto"
                }
              }
            }
          }
        },
        "summary": "Microsoft Teams add-on status",
        "tags": [
          "teams"
        ]
      }
    },
    "/api/addons/jira/status": {
      "get": {
        "operationId": "JiraController_status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddonStatusDto"
                }
              }
            }
          }
        },
        "summary": "Jira add-on status",
        "tags": [
          "jira"
        ]
      }
    },
    "/api/addons/linear/status": {
      "get": {
        "operationId": "LinearController_status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddonStatusDto"
                }
              }
            }
          }
        },
        "summary": "Linear add-on status",
        "tags": [
          "linear"
        ]
      }
    },
    "/api/addons/github/status": {
      "get": {
        "operationId": "GithubController_status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddonStatusDto"
                }
              }
            }
          }
        },
        "summary": "GitHub add-on status",
        "tags": [
          "github"
        ]
