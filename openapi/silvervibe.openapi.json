          "github"
        ]
      }
    }
  },
  "info": {
    "title": "Silvervibe API",
    "description": "HTTP API for Silvervibe apps and product add-ons.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "workspaces",
      "description": ""
    },
    {
      "name": "flags",
      "description": ""
    },
    {
      "name": "slack",
      "description": ""
    },
    {
      "name": "teams",
      "description": ""
    },
    {
      "name": "jira",
      "description": ""
    },
    {
      "name": "linear",
      "description": ""
    },
    {
      "name": "github",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Firebase ID token. Outside production, when Admin is unset: Bearer dev:<uid>."
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "CustomTokenDto": {
        "type": "object",
        "properties": {
          "customToken": {
            "type": "string"
          }
        },
        "required": [
          "customToken"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Neon user id (cuid)"
          },
          "firebaseUid": {
            "type": "string",
            "description": "Firebase Auth uid"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "firebaseUid"
        ]
      },
      "MeWorkspaceToolDto": {
        "type": "object",
        "properties": {
          "toolKey": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "toolKey",
          "enabled"
        ]
      },
      "MeWorkspaceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "MEMBER"
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeWorkspaceToolDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role",
          "tools"
        ]
      },
      "CreateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme"
          },
          "slug": {
            "type": "string",
            "example": "acme"
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "WorkspaceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "WorkspaceToolDto": {
        "type": "object",
        "properties": {
          "toolKey": {
            "type": "string",
            "example": "vibestandup"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "toolKey",
          "enabled"
        ]
      },
      "SetToolEntitlementDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "true = grant / keep entitlement; false = revoke"
          }
        },
        "required": [
          "enabled"
        ]
      },
      "MyTeamDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ]
      },
      "CreateTeamDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Platform"
          },
          "slug": {
            "type": "string",
            "example": "platform"
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "TeamDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "TeamMemberDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          },
          "email": {
            "type": "object",
            "nullable": true
          },
          "displayName": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "userId",
          "role"
        ]
      },
      "InviteTeamMemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Firebase UID or existing Neon user id"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          }
        },
        "required": [
          "userId"
        ]
      },
      "CreateTeamInviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "teammate@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          }
        },
        "required": [
          "email"
        ]
      },
      "TeamInviteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "teamId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REVOKED"
            ]
          },
          "token": {
            "type": "string"
          },
          "acceptPath": {
            "type": "string",
            "description": "Relative path for the invitee to open after sign-in"
          },
          "expiresAt": {
            "type": "string"
          },
          "member": {
            "description": "Set when the invitee was added immediately (already a user)",
            "allOf": [
              {
                "$ref": "#/components/schemas/TeamMemberDto"
              }
            ]
          },
          "emailSent": {
            "type": "boolean",
            "description": "True when an invite email was sent via Resend for this response"
          },
          "emailError": {
            "type": "string",
            "description": "Resend error message when emailSent is false after a send attempt"
          }
        },
        "required": [
          "id",
          "teamId",
          "email",
          "role",
          "status",
          "token",
          "acceptPath",
          "expiresAt"
        ]
      },
      "AcceptTeamInviteDto": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "member": {
            "$ref": "#/components/schemas/TeamMemberDto"
          }
        },
        "required": [
          "teamId",
          "workspaceId",
          "member"
        ]
      },
      "StandupConfigDto": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "questionsJson": {
            "type": "object"
          }
        },
        "required": [
          "teamId",
          "timezone",
          "questionsJson"
        ]
      },
      "UpdateStandupConfigDto": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string"
          },
          "questionsJson": {
            "type": "object"
          }
        },
        "required": [
          "timezone",
          "questionsJson"
        ]
      },
      "StandupEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "teamId": {
            "type": "string"
          },
          "entryDate": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SUBMITTED"
            ]
          },
          "yesterday": {
            "type": "object",
            "nullable": true
          },
          "today": {
            "type": "object",
            "nullable": true
          },
          "blockers": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "teamId",
          "entryDate",
          "status"
        ]
      },
      "UpsertStandupEntryDto": {
        "type": "object",
        "properties": {
          "yesterday": {
            "type": "string"
          },
          "today": {
            "type": "string"
          },
          "blockers": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SUBMITTED"
            ]
          }
        },
        "required": [
          "yesterday",
          "today",
          "blockers",
          "status"
        ]
      },
      "StandupSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "teamId": {
            "type": "string"
          },
          "entryDate": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "teamId",
          "entryDate",
          "content"
        ]
      },
      "FlagEvaluationDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "enabled"
        ]
      },
      "AddonStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "slack"
          },
          "status": {
            "type": "string",
            "example": "ready"
          }
        },
        "required": [
          "name",
          "status"
        ]
      }
    }
  }
}