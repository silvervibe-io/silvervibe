generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) for the app; direct for migrate / introspect.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum StandupEntryStatus {
  DRAFT
  SUBMITTED
}

enum AddonProvider {
  SLACK
  TEAMS
  JIRA
  LINEAR
  GITHUB
}

enum AddonConnectionStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String?
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships     WorkspaceMember[]
  teamMemberships TeamMember[]
  standupEntries  StandupEntry[]
  invitesSent     TeamInvite[]      @relation("TeamInvitesSent")

  @@map("users")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /** Commercial plan key from plans.catalog.json (`free` | `team`). */
  planKey   String   @default("free") @map("plan_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members          WorkspaceMember[]
  tools            WorkspaceTool[]
  addonConnections AddonConnection[]
  teams            Team[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceTool {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  toolKey     String   @map("tool_key")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, toolKey])
  @@map("workspace_tools")
}

model AddonConnection {
  id           String                @id @default(cuid())
  workspaceId  String                @map("workspace_id")
  provider     AddonProvider
  status       AddonConnectionStatus @default(DISCONNECTED)
  externalId   String?               @map("external_id")
  secretsRef   String?               @map("secrets_ref")
  metadataJson Json?                 @map("metadata_json")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("addon_connections")
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  slug        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  invites       TeamInvite[]
  standupConfig StandupConfig?
  entries       StandupEntry[]
  summaries     StandupSummary[]

  @@unique([workspaceId, slug])
  @@map("teams")
}

model TeamInvite {
  id          String           @id @default(cuid())
  teamId      String           @map("team_id")
  email       String
  role        TeamRole         @default(MEMBER)
  token       String           @unique
  status      TeamInviteStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  invitedById String           @map("invited_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User @relation("TeamInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([email, status])
  @@map("team_invites")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model StandupConfig {
  id             String   @id @default(cuid())
  teamId         String   @unique @map("team_id")
  timezone       String   @default("UTC")
  reminderHour   Int      @default(9) @map("reminder_hour")
  reminderMinute Int      @default(0) @map("reminder_minute")
  questionsJson  Json     @default("{\"yesterday\":\"What did you do yesterday?\",\"today\":\"What will you do today?\",\"blockers\":\"Any blockers?\"}") @map("questions_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("standup_configs")
}

model StandupEntry {
  id          String             @id @default(cuid())
  teamId      String             @map("team_id")
  userId      String             @map("user_id")
  entryDate   DateTime           @map("entry_date") @db.Date
  status      StandupEntryStatus @default(DRAFT)
  yesterday   String?
  today       String?
  blockers    String?
  submittedAt DateTime?          @map("submitted_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, entryDate])
  @@map("standup_entries")
}

model StandupSummary {
  id                 String   @id @default(cuid())
  teamId             String   @map("team_id")
  entryDate          DateTime @map("entry_date") @db.Date
  content            String
  /// Last successful digest delivery fingerprint: { content, providers: { slack?, teams?, linear?, github?, jira? } }
  digestDeliveryJson Json?    @map("digest_delivery_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, entryDate])
  @@map("standup_summaries")
}
