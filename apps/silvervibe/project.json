{
  "name": "silvervibe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sv",
  "sourceRoot": "apps/silvervibe/src",
  "tags": ["type:app", "scope:silvervibe"],
  "targets": {
    "sync-firebase-web": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/sync-firebase-web-from-env.mjs"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["sync-firebase-web"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/silvervibe",
        "browser": "apps/silvervibe/src/main.ts",
        "tsConfig": "apps/silvervibe/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/silvervibe/public"
          }
        ],
        "styles": ["apps/silvervibe/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": ["sync-firebase-web"],
      "configurations": {
        "production": {
          "buildTarget": "silvervibe:build:production"
        },
        "development": {
          "buildTarget": "silvervibe:build:development"
        }
      },
      "options": {
        "port": 4200,
        "proxyConfig": "apps/silvervibe/proxy.conf.json",
        "prebundle": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "silvervibe:build",
        "port": 4200,
        "staticFilePath": "dist/apps/silvervibe/browser",
        "spa": true
      }
    }
  }
}
